# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development
CMS_URL=http://localhost:4000
SESSION_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cardekho_cms

# First admin, created by `npm run seed` (change the password after first sign-in).
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin

# The website (Next.js) and the secret it shares with the CMS for refresh calls.
SITE_URL=http://localhost:3001
REVALIDATE_SECRET=change-me-and-copy-to-website-.env.local
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# AI writing: providers tried in this order; one without a key is skipped.
AI_PROVIDER_ORDER=gemini,openai,claude
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Free data sources
OPENCHARGEMAP_API_KEY=
HTTP_USER_AGENT="WheeloraCMS/1.0 (contact: you@example.com)"

SCHEDULER_ENABLED=true
UPLOAD_DIR=uploads

# Automotive scraper service and its admin token (from ../automotive-scraper/.env).
SCRAPER_API_URL=http://localhost:4100
SCRAPER_ADMIN_TOKEN=

# CarScrapper tab: the Python scraper in ../cardekho (needs Python 3 with the "requests" package).
CARSCRAPER_PYTHON=python
CARSCRAPER_SCRIPT=../cardekho/scrape.py

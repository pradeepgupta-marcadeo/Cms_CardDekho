<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Sign in · Wheelora CMS</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/static/admin.css">
</head>
<body>
  <div class="login card">
    <h1>Wheelora CMS</h1>
    <p class="sub">Sign in to manage the website.</p>
    <% if (error) { %><div class="errors mt"><%= error %></div><% } %>
    <form method="post" action="/admin/login" class="mt">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field"><label class="f" for="email">Email</label><input id="email" type="email" name="email" value="<%= email %>" autocomplete="username" required autofocus></div>
      <div class="field"><label class="f" for="password">Password</label><input id="password" type="password" name="password" autocomplete="current-password" required></div>
      <button class="btn lime" style="width:100%;justify-content:center">Sign in</button>
    </form>
  </div>
</body>
</html>

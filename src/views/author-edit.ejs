<%- include("partials/head", { title }) %>
<div class="top"><div><p class="sub"><a href="/admin/authors">← Authors</a></p><h1><%= isNew ? "New author" : a.name %></h1></div></div>
<%# A multipart form is read after the CSRF check, so the token also travels in the address. %>
<form method="post" action="/admin/authors/<%= isNew ? "new" : a.id %>?_csrf=<%= csrf %>" enctype="multipart/form-data" class="card" style="max-width:760px">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="grid g2">
    <div class="field"><label class="f" for="name">Name <b class="req">*</b></label><input id="name" name="name" type="text" value="<%= a.name %>" required></div>
    <div class="field"><label class="f" for="designation">Designation</label><input id="designation" name="designation" type="text" value="<%= a.designation %>" placeholder="Auto Correspondent"></div>
    <div class="field"><label class="f" for="email">Email</label><input id="email" name="email" type="email" value="<%= a.email %>"></div>
    <div class="field"><label class="f" for="image">Photo</label><input id="image" name="image" type="file" accept="image/jpeg,image/png,image/webp"><% if (a.image) { %><label class="check" style="margin-top:6px"><input type="checkbox" name="remove_image"> Remove the current photo</label><% } %></div>
  </div>
  <div class="field"><label class="f" for="bio">Short bio</label><textarea id="bio" name="bio"><%= a.bio %></textarea><div class="hint">Shown on the author's page.</div></div>
  <label class="check"><input type="checkbox" name="active" <%= a.active ? "checked" : "" %>> Active: new stories are shared out among active authors</label>
  <div class="savebar" style="position:static;border:0;padding:16px 0 0">
    <button class="btn lime"><%= isNew ? "Add author" : "Save changes" %></button>
    <a class="btn light" href="/admin/authors">Cancel</a>
  </div>
</form>
<%- include("partials/foot") %>

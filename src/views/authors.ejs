<%- include("partials/head", { title }) %>
<%
  const qs = (o) => { const p = new URLSearchParams(); for (const [k, v] of Object.entries({ q, state, ...o })) if (v) p.set(k, v); const s = p.toString(); return s ? `?${s}` : ""; };
  const MON = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const day = (d) => { const x = new Date(d); return `${String(x.getDate()).padStart(2, "0")} ${MON[x.getMonth()]} ${x.getFullYear()}`; };
  const src = (u) => (!u ? "" : /^https?:/.test(u) ? u : siteUrl + u);
%>
<div class="top">
  <div><h1>Authors</h1><p class="sub">The writers named on news and review stories. New stories written by the scraper are shared out among the active ones.</p></div>
  <div class="actions"><a class="btn lime" href="/admin/authors/new">+ New author</a></div>
</div>

<div class="card">
  <form method="get" action="/admin/authors" class="filters">
    <input type="search" name="q" value="<%= q %>" placeholder="Search authors…" aria-label="Search authors">
    <button class="btn light">Search</button>
    <select name="state" aria-label="Show" onchange="this.form.submit()"><option value="">All</option><option value="active" <%= state === "active" ? "selected" : "" %>>Active</option><option value="inactive" <%= state === "inactive" ? "selected" : "" %>>Inactive</option></select>
    <span class="grow"></span>
    <span class="muted"><%= total %> authors</span>
  </form>
  <form id="bulk" method="post" action="/admin/authors/bulk" class="bulkbar" hidden>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <b data-selected>0 selected</b>
    <button class="btn light small" name="action" value="activate">Activate</button>
    <button class="btn light small" name="action" value="deactivate">Deactivate</button>
    <button class="btn red small" name="action" value="delete" data-confirm="Delete the selected authors? Their stories keep the byline.">Delete</button>
  </form>
</div>

<div class="card flush">
  <div class="scroll-x">
  <table class="mgr">
    <thead><tr><th class="w10"><input type="checkbox" data-all aria-label="Select all"></th><th class="w64">Image</th><th>Name</th><th>Designation</th><th>Email</th><th>Stories</th><th>Created</th><th>Active</th><th class="right">Actions</th></tr></thead>
    <tbody>
      <% for (const a of list) { %>
        <tr>
          <td><input type="checkbox" name="ids" value="<%= a.id %>" form="bulk" data-row aria-label="Select <%= a.name %>"></td>
          <td><% if (a.image) { %><img class="thumb" style="width:40px;height:40px;border-radius:50%" src="<%= src(a.image) %>" alt="" width="40" height="40" loading="lazy"><% } else { %><span class="muted">—</span><% } %></td>
          <td><a class="ttl" href="/admin/authors/<%= a.id %>"><%= a.name %></a></td>
          <td><%= a.designation || "—" %></td>
          <td><%= a.email || "—" %></td>
          <td><%= a.stories %></td>
          <td class="nowrap muted"><%= day(a.created_at) %></td>
          <td><span class="state <%= a.active ? 'ok' : 'warn' %>"><i></i><%= a.active ? "Yes" : "No" %></span></td>
          <td class="nowrap right">
            <form class="inline" method="post" action="/admin/authors/<%= a.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="ico <%= a.active ? 'amber' : 'green' %>" title="<%= a.active ? 'Deactivate' : 'Activate' %>" aria-label="<%= a.active ? 'Deactivate' : 'Activate' %> <%= a.name %>"><%= a.active ? "⏸" : "✓" %></button></form>
            <a class="ico" title="Edit" aria-label="Edit <%= a.name %>" href="/admin/authors/<%= a.id %>">✎</a>
            <form class="inline" method="post" action="/admin/authors/<%= a.id %>/delete" data-confirm="Delete <%= a.name %>? Their stories keep the byline."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="ico del" title="Delete" aria-label="Delete <%= a.name %>">🗑</button></form>
          </td>
        </tr>
      <% } %>
      <% if (!list.length) { %><tr><td colspan="9" class="empty"><b>No authors yet</b><br><span class="muted">Add your writers. Until you do, stories are credited to <b>Wheelora Desk</b>.</span></td></tr><% } %>
    </tbody>
  </table>
  </div>
  <% if (pages > 1) { %>
    <div class="pager" style="padding:12px 16px;border-top:1px solid var(--line);margin:0">
      <span class="muted">Page <%= page %> of <%= pages %> · <%= total %> total</span><span class="grow"></span>
      <% if (page > 1) { %><a class="btn light small" href="<%= qs({ page: page - 1 }) %>">← Previous</a><% } %>
      <% if (page < pages) { %><a class="btn light small" href="<%= qs({ page: page + 1 }) %>">Next →</a><% } %>
    </div>
  <% } %>
</div>
<script type="module" src="/static/news-manager.js"></script>
<%- include("partials/foot") %>

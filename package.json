{
  "name": "cms_cardekho",
  "version": "1.0.0",
  "private": true,
  "description": "Wheelora CMS: manages every piece of content on the Wheelora car website.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "seed": "node src/scripts/seed.js",
    "setup": "node src/scripts/migrate.js && node src/scripts/seed.js",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "npm run lint && npm test",
    "ai:cars": "node src/scripts/ai-batch.js cars",
    "ai:news": "node src/scripts/ai-batch.js news"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "bcryptjs": "^3.0.3",
    "ckeditor5": "^49.1.0",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
